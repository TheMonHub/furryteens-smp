{
    "schemaVersion": 1,
    "id": "ftsmp",
    "version": "${version}",
    "name": "Furryteens SMP",
    "description": "A mod made for furryteens SMP",
    "authors": [
        "TheMonHub"
    ],
    "contact": {
        "homepage": "https://github.com/TheMonHub/furryteens-smp",
        "sources": "https://github.com/TheMonHub/furryteens-smp"
    },
    "license": "CC0-1.0",
    "icon": "assets/ftsmp/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "net.themonhub.ftsmp.FtSmp",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "ftsmp.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}",
        "fabric-api": "*",
        "fabric-language-kotlin": "*",
        "fzzy_config": "*"
    }
}
